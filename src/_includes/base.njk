<!DOCTYPE html>
<html lang="{{ locale | default('fr') }}">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width,initial-scale=1" name="viewport"/>
<title>{{ title }} — Ora-ïto</title>
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600;700&amp;family=Spline+Sans+Mono:wght@400;500&amp;display=swap" rel="stylesheet"/>
<link href="/assets/style.css" rel="stylesheet"/>
</head>
<body>
<header class="site">
  <div class="wrap">
    <div class="bar">
      <a class="logo" href="{{ '/' if locale == 'fr' else '/en/' }}">ora<span class="dot">·</span><b>ïto</b></a>
      <button class="menu-btn" onclick="toggleMenu()">Menu</button>
      <nav class="main">
{% if locale == 'en' %}
        <a href="/en/profil/">Profile</a>
        <a href="/en/projets/">Projects</a>
        <a href="/en/mamo/">MAMO</a>
        <a href="/en/news/">News</a>
        <a class="lang-switch" href="{{ page.url | replace('/en/', '/') }}" style="margin-left: 20px; font-weight: 500;">FR</a>
{% else %}
        <a href="/profil/">Profil</a>
        <a href="/projets/">Projets</a>
        <a href="/mamo/">MAMO</a>
        <a href="/news/">Actualités</a>
        <a class="lang-switch" href="/en{{ page.url }}" style="margin-left: 20px; font-weight: 500;">EN</a>
{% endif %}
      </nav>
    </div>
  </div>
</header>

{{ content | safe }}

<footer class="site">
  <div class="wrap">
    <div class="foot">
      <div class="big">simplicity is<br/>the ultimate<br/>sophistication<span class="dot">.</span></div>
      <div class="small">Studio Ora-ïto<br/>
{% if locale == 'en' %}
      Product design · furniture · architecture<br/>Paris — since 1998
{% else %}
      Design produit · mobilier · architecture<br/>Paris — depuis 1998
{% endif %}
      </div>
    </div>
{% if page.url == '/' or page.url == '/en/' %}
    <p class="disclaimer">Direction artistique inspirée des codes éditoriaux des grandes maisons de design. Les images sont servies depuis le serveur d'origine. Contenu &amp; visuels © Ora-ïto / ayants droit.</p>
{% endif %}
  </div>
</footer>
<script src="/assets/app.js"></script>
</body>
</html>
